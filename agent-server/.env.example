# ============================================================
#  复制本文件为 .env 后填写。.env 已在 .gitignore 中，不会被提交。
#  优先级：进程环境变量 > 本文件 > 代码默认值
# ============================================================

# ---------- 对话模型 ----------
# 任何 OpenAI 兼容端点都行：智谱 / 百炼 / DeepSeek / 本地 vLLM
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.7

# 智谱新模型默认开"深度思考"，在工具调用前会先内部推理一段。
# 对"查数据 / 调工具"这类标准任务是纯浪费 token，关掉约提速一倍。
# 换非智谱端点时此项自动不生效。
LLM_DISABLE_THINKING=true

# ---------- 被智能体操作的目标系统 ----------
DJRBAC_BASE=http://127.0.0.1:8000

# 独立演示页（http://127.0.0.1:8200/）切账号时用的统一密码，
# 与 README「演示账号」里的密码一致。只有下面 AGENT_ALLOW_USER_LOGIN=true
# 时才会用到 —— 从后台管理系统里打开智能体走的是令牌，不需要它。
# 变量名必须是 DJRBAC_PASSWORD（config.py 按这个名字读）。
DJRBAC_PASSWORD=

# ---------- 身份校验 ----------
# 默认 false：一律要求前端传登录令牌（token），不接受"只报账号名"。
# 打开后，本机任何人都能只凭账号名以该身份查数据，只适合断网的本机演示。
AGENT_ALLOW_USER_LOGIN=false

# 会话回收：空闲超过 N 秒丢掉；内存里最多保留 N 个会话
AGENT_SESSION_TTL=1800
AGENT_MAX_SESSIONS=100

# ---------- 用量上报与预算 ----------
# 与 backend/.env 填同一个值。留空 = 不上报（后端接口也会拒绝），
# 这样"没配"和"配错"一样明显，不会静默地什么都不记。
INTERNAL_API_KEY=

# 单账号每日 token 预算，0 = 不限制（默认）。
# 开着的时候超限会在下一轮对话直接拒绝，并说明已用/上限。
# 演示环境别配太小，否则自己把演示拦下来。
LLM_DAILY_BUDGET_TOKENS=0

# 上报接口超时（秒）。调小是故意的：看板晚几秒没关系，对话卡住不行。
AGENT_REPORT_TIMEOUT=3

# ---------- 智能体服务自身 ----------
AGENT_HOST=127.0.0.1
AGENT_PORT=8200

# 允许跨域的前端地址（逗号分隔）。不在这里的来源不会拿到 CORS 响应头，
# 浏览器会挡住它的跨源读取 —— 这是"响应能被陌生网页读走"的那道防线。
AGENT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5180,http://127.0.0.1:5180
