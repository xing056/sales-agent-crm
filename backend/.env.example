# ============================================================
#  复制本文件为 backend/.env 后按自己的环境修改。
#  .env 已在 .gitignore 中，不会被提交（数据库密码不进仓库）。
# ============================================================

DJANGO_SECRET_KEY=change-me-to-a-random-string
# 默认关闭：开着的时候，报错页会把堆栈、SQL、局部变量直接吐给访问者。
# 本机开发想要详细报错页 / debug toolbar 时改成 true，别再带上生产环境。
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*

# ---------- MySQL ----------
# 先建库并导入 backend/sql/seed.sql（见 README「准备数据库」）
DB_NAME=dj_rbac
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ---------- 服务间调用 ----------
# 智能体服务（8200）把模型用量上报到 /api/llm_usage/report/ 时用的共享密钥。
# 留空 = 关闭上报（该接口会拒绝一切请求）。要开启就在两边填同一个随机串：
#   python -c "import secrets;print(secrets.token_hex(24))"
INTERNAL_API_KEY=
